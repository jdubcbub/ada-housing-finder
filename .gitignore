
# ==========================================
# Dependencies
# ==========================================
# Catches node_modules at the root, /client, and /server
**/node_modules/
.pnp
.pnp.js

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
# Express and React both use these to store API keys and ports
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ==========================================
# Build & Production Outputs
# ==========================================
# React build outputs (Vite uses dist/, Create React App uses build/)
**/dist/
**/build/

# Express/Node build outputs (if using TypeScript or a bundler)
**/out/
*.tsbuildinfo

# ==========================================
# Logs
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# System & Editor Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?